    }
  },
  {
    "id": 3,
    "priority": 2,
    "action": { "type": "allow" },
    "condition": {
      "regexFilter": "^https://(www\\.)?instagram\\.com/(web/login|data/privacy)(/|[?#]|$)",
      "resourceTypes": ["main_frame"]
    }
  }
