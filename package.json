{
  "name": "insta-lite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/core.test.mjs tests/background.test.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "verify": "npm run check && npm test && npm run build && npm run verify:packages",
    "dev": "node scripts/serve.mjs",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:packages": "node scripts/verify-packages.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "Instagram, without the scroll. A local-first Chrome and Edge inbox extension.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rishikeshsanin/INSTA_LITE.git"
  },
  "bugs": {
    "url": "https://github.com/Rishikeshsanin/INSTA_LITE/issues"
  },
  "devDependencies": {
    "axe-core": "4.13.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9"
  }
}
